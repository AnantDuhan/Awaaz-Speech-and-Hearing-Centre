From 8654ba756400421edbfc27d322ada0d7149eab14 Mon Sep 17 00:00:00 2001
From: Anant <duhananant@gmail.com>
Date: Sun, 8 Nov 2026 00:34:13 +0530
Subject: [PATCH] Fix Google Maps "refused to connect" and the opening-hours
 build error

- Visit us: only show the map iframe for Google "Embed a map" URLs
  (https://www.google.com/maps/embed?pb=...). Share links such as
  share.google and maps.app.goo.gl are blocked by Google inside iframes,
  so the section now shows an "Open in Google Maps" card instead
- "Get directions" opens the Maps listing (google.profileUrl) when set,
  instead of building a route from the free-text address
- ClinicJsonLd: use flatMap so the new OpeningHours union type
  type-checks; `next build` failed with "Property 'opens' does not exist"
- check:launch: flag a mapEmbedUrl that isn't an embed URL
- site.ts: clearer instructions for getting the embed URL

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MGhNXU7GgtobKHL4WvPJEa
---
 scripts/check-launch.mjs          |  6 ++++
 src/components/ClinicJsonLd.tsx   | 21 ++++++++-----
 src/components/VisitUs.module.css | 50 +++++++++++++++++++++++++------
 src/components/VisitUs.tsx        | 34 +++++++++++++++------
 src/content/site.ts               |  5 +++-
 5 files changed, 89 insertions(+), 27 deletions(-)

diff --git a/scripts/check-launch.mjs b/scripts/check-launch.mjs
index 363f759..6251ad7 100644
--- a/scripts/check-launch.mjs
+++ b/scripts/check-launch.mjs
@@ -24,6 +24,12 @@ lines.forEach((line, index) => {
   if (/(mapEmbedUrl|profileUrl|reviewsUrl):\s*""/.test(text)) {
     todo.push(`${at}: add the Google link — ${text.split(":")[0]}`);
   }
+  const embed = text.match(/mapEmbedUrl:\s*"([^"]+)"/);
+  if (embed && !embed[1].startsWith("https://www.google.com/maps/embed")) {
+    todo.push(
+      `${at}: mapEmbedUrl is a share link, which Google blocks in iframes — use the "Embed a map" src (https://www.google.com/maps/embed?pb=…)`,
+    );
+  }
 });
 
 if (todo.length === 0) {
diff --git a/src/components/ClinicJsonLd.tsx b/src/components/ClinicJsonLd.tsx
index 094b077..9737cdc 100644
--- a/src/components/ClinicJsonLd.tsx
+++ b/src/components/ClinicJsonLd.tsx
@@ -26,14 +26,19 @@ export function ClinicJsonLd() {
       postalCode: address.pin,
       addressCountry: address.country,
     },
-    openingHoursSpecification: site.hours
-      .filter((row) => !row.closed && !isPlaceholder(row.opens) && !isPlaceholder(row.closes))
-      .map((row) => ({
-        "@type": "OpeningHoursSpecification",
-        dayOfWeek: row.days,
-        opens: row.opens,
-        closes: row.closes,
-      })),
+    // flatMap (not filter + map) so TypeScript knows closed days have no opens/closes.
+    openingHoursSpecification: site.hours.flatMap((row) =>
+      row.closed || isPlaceholder(row.opens) || isPlaceholder(row.closes)
+        ? []
+        : [
+            {
+              "@type": "OpeningHoursSpecification",
+              dayOfWeek: row.days,
+              opens: row.opens,
+              closes: row.closes,
+            },
+          ],
+    ),
     ...(google.profileUrl ? { hasMap: google.profileUrl, sameAs: [google.profileUrl] } : {}),
   };
 
