+  align-items: center;
+  justify-content: center;
+  height: 380px;
+  padding: 24px;
+  text-align: center;
+  font-weight: 800;
+  color: var(--placeholder-text);
+  background: repeating-linear-gradient(
+    135deg,
+    var(--placeholder-a) 0 14px,
+    var(--placeholder-b) 14px 28px
+  );
+}
+
+.details {
+  display: flex;
+  flex-direction: column;
+  gap: 24px;
+}
+
+.facts {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.facts li {
+  display: flex;
+  align-items: flex-start;
+  gap: 14px;
+}
+
+.facts a {
+  font-weight: 800;
+}
+
+.factIcon {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 40px;
+  height: 40px;
+  border-radius: 50%;
+  background: var(--tint);
+  color: var(--accent);
+}
+
+.hours {
+  display: flex;
+  flex-direction: column;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+}
+
+.reviews,
+.reviews:hover {
+  gap: 8px;
+  color: var(--ink);
+  border-color: var(--border);
+  background: var(--surface);
+}
+
+@media (max-width: 860px) {
+  .grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .details {
+    order: -1;
+  }
+
+  .map,
+  .mapPlaceholder {
+    height: 280px;
+  }
+}
